# Generate independent random hex values (openssl rand -hex 32).
# Hex-only DB password avoids URL encoding issues in docker-compose.yml.
TGB_DB_PASSWORD=
TGB_ADMIN_TOKEN=

TGB_ENCRYPTION_KEY=
# Set false for read-only inspection.
TGB_ENABLE_WORKERS=true

# Integer GiB; both must be positive.
TGB_CACHE_GIB=10
TGB_MIN_FREE_GIB=5

# Optional exact Google Web OAuth redirect URI; use HTTPS except loopback.
# TGB_GOOGLE_REDIRECT_URI=https://backup.example.com/api/oauth/google/callback

# Published host port (loopback only); container listens on 8081.
TGB_PORT=8080
