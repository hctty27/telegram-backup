# Bootstrap security. Generate once:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep this key safe and do not change it after credentials have been saved.
APP_ENCRYPTION_KEY=

# Initial admin login token (must be at least 32 random characters)
ADMIN_TOKEN=replace-with-a-long-random-secret

# Optional legacy Telegram settings. New installations can configure these in the web dashboard.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=../data/telegram

# Persistent application data
DATA_DIR=../data
DOWNLOAD_DIR=../data/downloads
DATABASE_URL=sqlite+aiosqlite:///../data/telegram_backup.db

# Optional legacy rclone config. Existing remotes are imported into encrypted database storage
# when APP_ENCRYPTION_KEY is configured. New Google Drive remotes can be added in the dashboard.
RCLONE_CONFIG=../rclone/rclone.conf
RCLONE_REMOTE=backup:TelegramBackup

# Background worker tuning
BACKUP_SCAN_INTERVAL_SECONDS=300
WORKER_POLL_SECONDS=5
