# Telegram application credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=../data/telegram

# Use a long, random value. This token protects every management API endpoint.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Persistent application data (relative to the backend directory for local development)
DATA_DIR=../data
DOWNLOAD_DIR=../data/downloads
DATABASE_URL=sqlite+aiosqlite:///../data/telegram_backup.db

# rclone configuration and destination. Example: backup:TelegramBackup
RCLONE_CONFIG=../rclone/rclone.conf
RCLONE_REMOTE=backup:TelegramBackup

# Background worker tuning
BACKUP_SCAN_INTERVAL_SECONDS=300
WORKER_POLL_SECONDS=5
