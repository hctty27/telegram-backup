# Generate independent random hex values (openssl rand -hex 32).
# Hex-only DB password avoids URL encoding issues in compose.v2.yaml.
V2_DB_PASSWORD=
V2_ADMIN_TOKEN=

V2_ENCRYPTION_KEY=
# Set false for read-only inspection.
V2_ENABLE_WORKERS=true

# Integer GiB; both must be positive.
V2_CACHE_GIB=10
V2_MIN_FREE_GIB=5
